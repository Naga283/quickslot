datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String     @id @default(uuid())
  name      String
  email     String     @unique
  bookings  Booking[]
  waitlists Waitlist[]
}

model Venue {
  id        String   @id @default(uuid())
  name      String
  sportType String
  address   String
  imageUrl  String?
  slots     Slot[]

  @@index([sportType])
}

enum SlotStatus {
  AVAILABLE
  BOOKED
}

model Slot {
  id        String     @id @default(uuid())
  venueId   String
  venue     Venue      @relation(fields: [venueId], references: [id], onDelete: Cascade)
  date      DateTime   @db.Date
  startTime DateTime
  endTime   DateTime
  status    SlotStatus @default(AVAILABLE)
  booking   Booking?
  waitlists Waitlist[]

  @@index([venueId, date])
  @@index([date, startTime])
}

model Booking {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  slotId    String   @unique
  slot      Slot     @relation(fields: [slotId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId])
}

model Waitlist {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  slotId    String
  slot      Slot     @relation(fields: [slotId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([slotId, userId])
  @@index([userId])
  @@index([slotId, createdAt])
}
